{
    "compilerOptions": {
        "noEmit": true,

        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext", 

        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "skipLibCheck": true,

        "outDir": "./dist",
        "rootDir": "./src",

        "types": ["node", "jest"],

        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,

        "paths": {
            "*": ["./src/*", "./node_modules/*"],
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}